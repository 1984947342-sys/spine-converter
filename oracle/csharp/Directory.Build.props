<Project>
  <!-- Build output stays in zig-out -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\zig-out\csharp\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\zig-out\csharp\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
