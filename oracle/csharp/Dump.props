<Project>
  <!-- Shared by Dump35 to Dump42, SpineVersion picks the runtime -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0414;CS0618;CS0649;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\testdata\runtimes\$(SpineVersion)\spine-csharp\src\**\*.cs" />
    <Compile Include="..\Output.cs" />
    <Compile Include="..\SpcEditor.cs" />
    <Compile Include="..\Dump.cs" />
  </ItemGroup>
</Project>
