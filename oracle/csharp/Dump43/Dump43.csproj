<Project Sdk="Microsoft.NET.Sdk">
  <!-- Output mirrors oracle/dump_4.3.cpp -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0414;CS0618;CS0649;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same exclusions as spine-csharp.csproj -->
    <Compile Include="..\..\..\testdata\runtimes\4.3\spine-csharp\src\**\*.cs" Exclude="..\..\..\testdata\runtimes\4.3\spine-csharp\src\ColorUnity.cs;..\..\..\testdata\runtimes\4.3\spine-csharp\src\ColorMono.cs" />
    <Compile Include="..\Output.cs" />
    <Compile Include="..\SpcEditor.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
